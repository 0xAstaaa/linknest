# ─── Local development ───────────────────────────────────────────────
# Leave DATABASE_URL unset to use the local SQLite file (prisma/dev.db).

# Password for the owner dashboard (/login). CHANGE THIS.
DASHBOARD_PASSWORD="change-me"

# Secret used to sign the session cookie. Use a long random string.
# If unset, a value derived from the password is used (fine for local).
SESSION_SECRET="generate-a-long-random-string"

# ─── Production (Turso + Vercel) ─────────────────────────────────────
# Your Turso database URL, e.g. libsql://your-db-name.turso.io
# DATABASE_URL="libsql://your-db-name.turso.io"

# Your Turso auth token (used by the app at runtime).
# DATABASE_AUTH_TOKEN="eyJhbGciOi..."
