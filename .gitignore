# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (keep the example, ignore real secrets)
.env*
!.env.example

# local SQLite database
/prisma/dev.db
/prisma/dev.db-journal
*.db
*.db-journal

# next.js dev-tooling agent file (auto-generated by `next dev`)
AGENTS.md

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
